#!/bin/sh /etc/rc.common
#
# picoclaw-webui - procd init script
#
# Lives at /etc/init.d/picoclaw-webui and is invoked by procd at the
# configured START priority (99). All state is read from UCI section
# `picoclaw.@webui`, so the LuCI app and this script share a single
# source of truth.
#
# The init script only consumes a small set of literal action names
# (`start`, `stop`, `restart`, `enable`, `disable`, `running`, `status`)
# and ignores any other argument, which is what makes the LuCI-side
# rpcd endpoint (`luci.picoclaw.set_action`) safe to bind to it.

USE_PROCD=1
START=99
STOP=10

NAME=picoclaw-webui
PROG=/opt/picoclaw/picoclaw-launcher

# State shared with the procd-respawn loop.
PIDFILE=/var/run/picoclaw-webui.pid

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

uci_get() {
    local _v
    _v=$(/sbin/uci -q get "picoclaw.webui.$1")
    [ -z "$_v" ] && _v="$2"
    printf '%s' "$_v"
}

log() {
    /usr/bin/logger -t picoclaw-webui -- "$@"
}

ensure_logfile() {
    [ -f /var/log/picoclaw-webui.log ] || : > /var/log/picoclaw-webui.log
}

# ---------------------------------------------------------------------------
# procd instance
# ---------------------------------------------------------------------------

start_service() {
    local enabled port verbosity

    enabled=$(uci_get enabled 0)
    port=$(uci_get port 18800)
    verbosity=$(uci_get verbosity 1)

    if [ "$enabled" != "1" ]; then
        log "start skipped: picoclaw.webui.enabled != 1"
        return 0
    fi

    if [ ! -x "$PROG" ]; then
        log "ERROR: launcher not found or not executable: $PROG"
        return 1
    fi

    ensure_logfile

    procd_open_instance
    procd_set_param command "$PROG"
    procd_set_param env \
        PICOCLAW_PORT="$port" \
        PICOCLAW_VERBOSITY="$verbosity" \
        PICOCLAW_CONFIG="/etc/config/picoclaw" \
        PICOCLAW_LOGFILE="/var/log/picoclaw-webui.log"

    # Restart on UCI commit. procd watches the path and respawns.
    procd_set_param file /etc/config/picoclaw

    # Respawn parameters: threshold, retry, retry_sleep.
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_set_param pidfile "$PIDFILE"

    procd_open_trigger
    procd_add_config_trigger "config.change" "picoclaw" \
        /etc/init.d/"$NAME" reload
    procd_close_trigger

    procd_close_instance

    log "instance started: port=$port verbosity=$verbosity"
}

stop_service() {
    # procd handles killing the instance. We just clean the pidfile and
    # let the wrapper log a clean shutdown.
    log "instance stopped"
    rm -f "$PIDFILE"
}

reload_service() {
    stop_service
    start_service
}

# ---------------------------------------------------------------------------
# extra_command handlers - used by /etc/init.d/<name> <verb>
# ---------------------------------------------------------------------------

extra_command "running" "Check whether the service is running"
extra_command "enabled" "Check whether the service is enabled at boot"

running_command() {
    if [ -f "$PIDFILE" ] && /bin/kill -0 "$(cat "$PIDFILE" 2>/dev/null)" 2>/dev/null; then
        return 0
    fi
    # Fallback: ask procd.
    if /sbin/ubus call service list '{"name":"'$NAME'"}' 2>/dev/null \
            | /bin/grep -q '"running":true'; then
        return 0
    fi
    return 1
}

enabled_command() {
    if /sbin/uci -q get "picoclaw.webui.enabled" 2>/dev/null \
            | /bin/grep -q '^1$'; then
        echo "enabled"
    else
        echo "disabled"
    fi
}

# Hardened: refuse any unknown subcommand. Anything beyond the procd-managed
# set (`start`, `stop`, `restart`, `reload`, `kill`, `running`, `status`)
# and our `enabled` extra command is rejected without further action.
case "$1" in
    ""|start|stop|restart|reload|kill|status|running|enabled)
        ;;
    *)
        log "refused unknown command: $1"
        echo "Unknown command: $1" >&2
        exit 2
        ;;
esac