#!/bin/sh /etc/rc.common
#
# picoclaw-webui - procd init script
#
# Lives at /etc/init.d/picoclaw-webui and is invoked by procd at the
# configured START priority (99).  All state is read from the UCI section
# `picoclaw.webui`, so the LuCI app and this script share a single source
# of truth.
#
# Autostart is represented in two places that must not drift apart:
#
#   * the UCI option `picoclaw.webui.enabled` (what the LuCI Configuration
#     page edits and what the Status page displays), and
#   * the /etc/rc.d/S99picoclaw-webui symlink that /etc/init.d/rcS uses to
#     decide whether the service is started at boot.
#
# `enable` / `disable` below are overridden so that both are always updated
# together, and every action re-syncs the symlink from the UCI option.  A
# plain `start` (the Status page "Start" button) is *not* gated on the
# enabled flag - "enabled" means "start at boot", not "may be started".
#
# NOTE: rc.common consumes the first two arguments before sourcing this
# file, so no position-based argument validation is possible (or needed)
# here - rc.common itself only dispatches commands it knows about.

USE_PROCD=1
START=99
STOP=10

NAME=picoclaw-webui

# The real launcher, owned by the picoclaw-webui package (this package must
# never install a file here, otherwise opkg reports a conflict).  When it is
# absent - freshly installed LuCI app, no picoclaw yet - the fallback shipped
# by this package is used so the WebUI link is functional out of the box.
LAUNCHER=/opt/picoclaw/picoclaw-launcher
PLACEHOLDER=/usr/libexec/picoclaw-launcher-placeholder
PROG="$LAUNCHER"

# Liveness state. This script owns the file: the instance wrapper below writes
# the pid and stop_service() removes it.  procd's own `pidfile` parameter is
# not used on purpose (see start_service), so the Status page relies on this
# file - together with a /proc scan and a check on the configured port - to
# decide whether the service is running.
PIDFILE=/var/run/picoclaw-webui.pid
LOGFILE=/var/log/picoclaw-webui.log

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

uci_get() {
    local _v
    _v=$(/sbin/uci -q get "picoclaw.webui.$1")
    [ -z "$_v" ] && _v="$2"
    printf '%s' "$_v"
}

# Print the launcher to run: the real one when it is usable, the bundled
# fallback otherwise.  Keep this in sync with resolve_launcher() in
# /usr/lib/lua/luci/picoclaw.lua and in the rpcd ucode plugin, which use the
# same order for the "is the service running" /proc scan.
resolve_launcher() {
    if [ -x "$LAUNCHER" ]; then
        printf '%s' "$LAUNCHER"
        return 0
    fi

    if [ -x "$PLACEHOLDER" ]; then
        printf '%s' "$PLACEHOLDER"
        return 0
    fi

    return 1
}

log() {
    /usr/bin/logger -t picoclaw-webui -- "$@"
}

# Keep the UCI autostart flag and the /etc/rc.d symlink in sync.  The
# symlink is what /etc/init.d/rcS evaluates at boot, the UCI option is what
# the LuCI UI shows and writes.
sync_autostart() {
    if [ "$(uci_get enabled 0)" = "1" ]; then
        [ -n "$START" ] && \
            ln -sf "../init.d/$NAME" "$IPKG_INSTROOT/etc/rc.d/S${START}${NAME}"
    else
        rm -f "$IPKG_INSTROOT/etc/rc.d/S${START}${NAME}" \
              "$IPKG_INSTROOT/etc/rc.d/K${STOP}${NAME}"
    fi
    return 0
}

set_uci_enabled() {
    # IPKG_INSTROOT is set while building an image; never touch the host's
    # UCI database in that case.
    [ -n "$IPKG_INSTROOT" ] && return 0
    /sbin/uci -q set "picoclaw.webui.enabled=$1" && /sbin/uci -q commit picoclaw
    return 0
}

# rc.common's enable/disable only manage the rc.d symlink; wrap them so the
# UCI flag follows along.
enable() {
    set_uci_enabled 1
    sync_autostart
    return 0
}

disable() {
    set_uci_enabled 0
    sync_autostart
    return 0
}

ensure_logfile() {
    [ -f "$LOGFILE" ] || : > "$LOGFILE"
}

# ---------------------------------------------------------------------------
# procd instance
# ---------------------------------------------------------------------------

start_service() {
    local port verbosity prog

    port=$(uci_get port 18800)
    verbosity=$(uci_get verbosity 1)

    prog=$(resolve_launcher)

    if [ -z "$prog" ]; then
        log "ERROR: no launcher found ($LAUNCHER, $PLACEHOLDER)"
        return 1
    fi

    PROG="$prog"

    if [ "$PROG" = "$PLACEHOLDER" ]; then
        log "using fallback launcher $PLACEHOLDER (install the real one at $LAUNCHER)"
    fi

    ensure_logfile

    procd_open_instance

    # The instance command is a tiny wrapper: the shell writes its own $$ into
    # the pidfile and then exec()s the launcher, so the recorded pid stays
    # valid and the file is created before the launcher does anything slow.
    # (procd's `pidfile` parameter cannot be used: it does not exist on all
    # supported releases and would duplicate the unlink, see below.)
    procd_set_param command /bin/sh -c "echo \$\$ > \"$PIDFILE\"; exec \"$PROG\""
    procd_set_param env \
        PICOCLAW_PORT="$port" \
        PICOCLAW_VERBOSITY="$verbosity" \
        PICOCLAW_CONFIG="/etc/config/picoclaw" \
        PICOCLAW_LOGFILE="$LOGFILE"

    # Restart the instance when the configuration file changes (procd
    # watches this path), and respawn it if it dies.
    procd_set_param file /etc/config/picoclaw
    procd_set_param respawn 3600 5 5
    procd_set_param stdout 1
    procd_set_param stderr 1

    # Deliberately NO `procd_set_param pidfile` here, although procd
    # releases after 24.10.x support it: the file is owned by the wrapper
    # above and removed by stop_service().  Letting procd manage it as well
    # makes both sides unlink the same path, and the loser logs
    # "Failed to remove pidfile: ...: No such file or directory" on every
    # stop.  Writing it ourselves also behaves identically on procd
    # versions without the parameter.

    procd_close_instance

    log "instance started: launcher=$PROG port=$port verbosity=$verbosity"
}

service_triggers() {
    # Service level trigger (instance level triggers are ignored by procd).
    procd_add_reload_trigger picoclaw
    sync_autostart
}

stop_service() {
    # procd handles killing the instance; we just clean up the pidfile and
    # let the wrapper log a clean shutdown.
    log "instance stopped"
    rm -f "$PIDFILE"
}

reload_service() {
    sync_autostart

    # Re-evaluate the instance definition: procd restarts the instance when
    # any parameter (port, verbosity, env, watched files) changed.
    start
}
