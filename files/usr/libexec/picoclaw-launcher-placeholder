#!/bin/sh
#
# /usr/libexec/picoclaw-launcher-placeholder
#
# Fallback launcher shipped by the luci-app-picoclaw package.
#
# The real launcher lives at /opt/picoclaw/picoclaw-launcher and is owned by
# the `picoclaw-webui` package (or installed by hand) - this package never
# touches that path, so the two cannot conflict in opkg.  The init script
# uses /opt/picoclaw/picoclaw-launcher whenever it exists and is executable
# and only falls back to this file otherwise, so the LuCI app's
# "Open WebUI" link stays functional on a fresh install.
#
# Recognised environment variables (set by /etc/init.d/picoclaw-webui):
#   PICOCLAW_PORT       - listen port (default 18800)
#   PICOCLAW_VERBOSITY  - 0..3, controls logging
#   PICOCLAW_LOGFILE    - log file path
#   PICOCLAW_DOCROOT    - docroot used by the uhttpd based fallback
#
# Replacement rules (downstream packages):
#   * Real picoclaw implementations MUST honour PICOCLAW_PORT and
#     PICOCLAW_LOGFILE so the LuCI app remains accurate.
#   * The launcher is invoked as a foreground process by procd; do not
#     daemonize.  Anything that forks into the background makes procd
#     believe the service crashed and restart it every respawn_timeout
#     seconds (that is what uhttpd does unless it is started with -f).

# picoclaw-launcher version: 1.0.0-placeholder
VERSION=1.0.0-placeholder

PORT="${PICOCLAW_PORT:-18800}"
VERBOSITY="${PICOCLAW_VERBOSITY:-1}"
LOGFILE="${PICOCLAW_LOGFILE:-/var/log/picoclaw-webui.log}"

# Docroot used by the uhttpd based placeholder.
DOCROOT="${PICOCLAW_DOCROOT:-/var/lib/picoclaw-placeholder}"

log() {
    [ "${VERBOSITY:-1}" -ge 1 ] || return 0
    printf '%s [%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "picoclaw-launcher" "$*" >>"$LOGFILE" 2>/dev/null
}

cleanup() {
    log "received signal, exiting"
    exit 0
}
trap cleanup INT TERM

log "starting placeholder launcher version=$VERSION port=$PORT"

# Preferred server: uhttpd, which ships with LuCI and is already running for
# the web UI.  It MUST be started with -f (do not fork), otherwise the
# process supervised by procd exits immediately and procd restarts the
# service in a tight loop.
if command -v uhttpd >/dev/null 2>&1; then
    if mkdir -p "$DOCROOT" 2>/dev/null; then
        cat > "$DOCROOT/index.html" <<HTML
<!DOCTYPE html>
<html>
<head>
<meta charset="utf-8">
<title>picoclaw placeholder</title>
<style>
body { font-family: sans-serif; margin: 3em; }
code { background: #eee; padding: 0 .3em; }
</style>
</head>
<body>
<h1>picoclaw placeholder launcher</h1>
<p>The real picoclaw launcher was not found at
<code>/opt/picoclaw/picoclaw-launcher</code>, so this built-in fallback is
serving the WebUI port.</p>
<p>version <code>$VERSION</code>, port <code>$PORT</code></p>
<p>Install or replace the real launcher at that path (make it executable,
then run <code>/etc/init.d/picoclaw-webui restart</code>) to deploy the full
feature set.</p>
</body>
</html>
HTML
        log "using uhttpd (foreground) on port $PORT, docroot $DOCROOT"
        exec uhttpd -f -p "$PORT" -h "$DOCROOT"
    fi

    log "ERROR: cannot create docroot $DOCROOT; falling back to nc"
else
    log "no uhttpd available, using shell placeholder"
fi

# Fallback: tiny single-shot HTTP responder built on busybox nc.
LISTEN_ADDR="0.0.0.0"

if ! command -v nc >/dev/null 2>&1; then
    log "ERROR: neither uhttpd nor nc available; placeholder cannot serve"
    sleep infinity
fi

while :; do
    nc -l -p "$PORT" -s "$LISTEN_ADDR" >>"$LOGFILE" 2>&1 <<EOF
HTTP/1.1 200 OK
Content-Type: text/plain; charset=utf-8
Cache-Control: no-store
Connection: close

picoclaw placeholder launcher (version $VERSION)
Set /etc/config/picoclaw -> webui.enabled=1 and run
    /etc/init.d/picoclaw-webui start
EOF
done
