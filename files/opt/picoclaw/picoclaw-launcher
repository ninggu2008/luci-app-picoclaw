#!/bin/sh
#
# /opt/picoclaw/picoclaw-launcher
#
# This file is the placeholder shipped by the luci-app-picoclaw package.
# In a real deployment it is overlaid by the `picoclaw-webui` package
# (or installed manually). The placeholder listens on TCP/18800 so the
# LuCI app's "Open WebUI" link is functional out of the box.
#
# Recognised environment variables (set by /etc/init.d/picoclaw-webui):
#   PICOCLAW_PORT       - listen port (default 18800)
#   PICOCLAW_VERBOSITY  - 0..3, controls logging
#   PICOCLAW_LOGFILE    - log file path
#
# Replacement rules (downstream packages):
#   * Real picoclaw implementations MUST honour PICOCLAW_PORT and
#     PICOCLAW_LOGFILE so the LuCI app remains accurate.
#   * The launcher is invoked as a foreground process by procd; do not
#     daemonize.

# picoclaw-launcher version: 1.0.0-placeholder
VERSION=1.0.0-placeholder

PORT="${PICOCLAW_PORT:-18800}"
VERBOSITY="${PICOCLAW_VERBOSITY:-1}"
LOGFILE="${PICOCLAW_LOGFILE:-/var/log/picoclaw-webui.log}"

log() {
    [ "${VERBOSITY:-1}" -ge 1 ] || return 0
    printf '%s [%s] %s\n' "$(date -u +'%Y-%m-%dT%H:%M:%SZ')" "picoclaw-launcher" "$*" >>"$LOGFILE" 2>/dev/null
}

cleanup() {
    log "received signal, exiting"
    exit 0
}
trap cleanup INT TERM

log "starting placeholder launcher version=$VERSION port=$PORT"

# Find a usable single-shot HTTP tool. Prefer uhttpd if available (it's
# already in PATH on ImmortalWRT), fall back to a tiny shell loop.
if command -v uhttpd >/dev/null 2>&1; then
    log "using uhttpd"
    exec uhttpd -p "$PORT" -h /dev/null -L 0
fi

# Fallback: shell-based placeholder that returns a self-identifying page
# on every request and writes a single line per request to the logfile.
log "no uhttpd available, using shell placeholder"

LISTEN_ADDR="127.0.0.1"
# Try to listen using busybox nc if present, otherwise exit.
if ! command -v nc >/dev/null 2>&1; then
    log "ERROR: neither uhttpd nor nc available; placeholder cannot serve"
    sleep infinity
fi

# Tiny TCP "HTTP" placeholder using a single-shot nc loop. Real picoclaw
# implementations are expected to provide their own server.
while :; do
    nc -l -p "$PORT" -s "$LISTEN_ADDR" >>"$LOGFILE" 2>&1 <<EOF
HTTP/1.1 200 OK
Content-Type: text/plain; charset=utf-8
Cache-Control: no-store
Connection: close

picoclaw placeholder launcher (version $VERSION)
Set /etc/config/picoclaw -> webui.enabled=1 and run
    /etc/init.d/picoclaw-webui start
EOF
done